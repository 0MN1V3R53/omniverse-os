# ==============================================================================
# OMNIVERSE PRODUCTION SECURITY HARDENED .HTACCESS FOR SKY AUTO SERVICES
# LITESPEED / APACHE ENTERPRISE WEB SERVER CONFIGURATION
# CISO Michael Chang & Dr. Alexander Vance
# ==============================================================================

# Disable Directory Browsing & MultiViews
Options -Indexes -MultiViews

RewriteEngine On

# 1. Force HTTPS & Canonical www.skyautoservices.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^skyautoservices\.com$ [NC]
RewriteRule ^(.*)$ https://www.skyautoservices.com/$1 [L,R=301]

# 2. Block Irrelevant CMS / WordPress Vulnerability Probes (Immediate 403 Forbidden)
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-login\.php|xmlrpc\.php|install\.php|setup-config\.php) - [F,L,NC]
RewriteCond %{QUERY_STRING} (install\.php|wp-admin|xmlrpc\.php) [NC]
RewriteRule ^ - [F,L]

# 3. Block Sensitive Files, Backups, Shell Scripts & Private Data (Immediate 403 Forbidden)
<FilesMatch "\.(env|txt|log|sql|bak|exp|sh|py|git|md|yml|yaml|unencrypted\.html)$">
    Require all denied
</FilesMatch>

# Block JSON Data Stores in Webroot (Protect Client PII & Database)
<FilesMatch "(quote_submissions|call_requests|visitor_telemetry|dmca_infringements)\.json$">
    Require all denied
</FilesMatch>

# Allow Public SEO & Frontend Data Files
<FilesMatch "^(robots\.txt|8f3b2a1c9e4d5f6a7b8c9d0e1f2a3b4c\.txt|sitemap.*\.xml|llm-feed\.json|zip_coordinates\.json|news_articles\.json)$">
    Require all granted
</FilesMatch>

# 4. Clean URLs & Automatic .html Extension Resolution
# Hub index pages
RewriteRule ^routes/?$ routes.html [L]
RewriteRule ^routes-directory/?$ routes-directory.html [L]
RewriteRule ^state-to-state-routes/?$ state-to-state-routes.html [L]
RewriteRule ^usa-auto-transport-news/?$ usa-auto-transport-news.html [L]

# Route specific subfolder clean URL rewrites
RewriteCond %{DOCUMENT_ROOT}/routes/$1.html -f
RewriteRule ^routes/([^/]+)/?$ routes/$1.html [L]

RewriteCond %{DOCUMENT_ROOT}/state-to-state-routes/$1.html -f
RewriteRule ^state-to-state-routes/([^/]+)/?$ state-to-state-routes/$1.html [L]

RewriteCond %{DOCUMENT_ROOT}/usa-auto-transport-news/$1.html -f
RewriteRule ^usa-auto-transport-news/([^/]+)/?$ usa-auto-transport-news/$1.html [L]

# If the exact file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# General root clean URL rewrite (e.g. /about -> /about.html, /services -> /services.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 5. Enterprise Security Headers (A+ SSL Labs / SecurityHeaders Standard)
<IfModule mod_headers.c>
    # Enforce HSTS (1 Year, Preload)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent MIME-type Sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Prevent Clickjacking & Framing Attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Legacy XSS Filter Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Restrict Referrer Information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Disable Unnecessary Hardware Sensor Permissions
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    
    # Content Security Policy (Allows Google Fonts, Images, Google Tag Manager, Google Ads, Analytics, and Pricing Engines)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google.com https://*.google.com https://www.gstatic.com https://*.gstatic.com https://www.googleadservices.com https://*.googleadservices.com https://googleads.g.doubleclick.net https://*.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.googletagmanager.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://*.googleadservices.com https://googleads.g.doubleclick.net https://script.google.com https://router.project-osrm.org; frame-src 'self' https://www.googletagmanager.com https://*.google.com https://*.doubleclick.net; frame-ancestors 'self';"
</IfModule>

# 6. High-Performance Compression (Brotli & Gzip)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 7. Browser & Static Asset Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
</IfModule>
